{
  "name": "@loveqoo/effect-actor",
  "version": "0.0.0",
  "description": "EffectTS 기반 Akka Typed 스타일 Actor 라이브러리",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "loveqoo <gunam.jung@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "example": "tsx",
    "format": "prettier --write \"{src,examples,test}/**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.13.0",
    "@types/node": "^22.7.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
