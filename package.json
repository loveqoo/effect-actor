{
  "name": "@loveqoo/effect-actor",
  "version": "0.0.0",
  "description": "EffectTS 기반 Akka Typed 스타일 Actor 라이브러리",
  "type": "module",
  "license": "MIT",
  "author": "loveqoo <gunam.jung@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "example": "tsx",
    "format": "prettier --write \"{src,examples,test}/**/*.{ts,tsx,md}\"",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.13.0",
    "@types/node": "^22.7.0",
    "effect": "^3.21.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
